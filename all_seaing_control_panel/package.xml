<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
    <name>all_seaing_control_panel</name>
    <version>0.0.0</version>
    <description>Arcturus control panel: web app (on the laptop) to run, monitor, check and analyze the boat and the simulation</description>
    <maintainer email="arcturus-logistics@mit.edu">arcturus</maintainer>
    <license>MIT</license>

    <buildtool_depend>ament_cmake_auto</buildtool_depend>
    <depend>rclpy</depend>
    <depend>diagnostic_msgs</depend>
    <depend>nav_msgs</depend>
    <depend>sensor_msgs</depend>
    <depend>tf2_msgs</depend>
    <depend>tf2_ros</depend>
    <depend>all_seaing_utility</depend>
    <exec_depend>python3-fastapi</exec_depend>
    <exec_depend>python3-uvicorn</exec_depend>
    <exec_depend>python3-paramiko</exec_depend>
    <exec_depend>python3-yaml</exec_depend>

    <export>
        <build_type>ament_cmake</build_type>
    </export>
</package>
